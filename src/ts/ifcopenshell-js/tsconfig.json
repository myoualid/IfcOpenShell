{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "ESNext.Disposable", "DOM"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "declaration": true,
    "declarationMap": true,
    "stripInternal": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@ifcopenshell/wasm": ["../ifcopenshell-wasm/index.d.ts"],
      "@ifcopenshell/wasm/api": ["../ifcopenshell-wasm/api.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  // Transpiled from ifcopenshell.util and ifcopenshell.api; built by tsconfig.python.json.
  "exclude": ["src/util", "src/api", "src/helpers/datetime.ts", "src/helpers/dateutil.ts", "src/helpers/geom.ts", "src/helpers/isodate.ts", "src/helpers/itertools.ts", "src/helpers/lang.ts", "src/helpers/numpy.ts", "src/helpers/os.ts"]
}
