{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "ESNext.Disposable", "DOM"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "declaration": true,
    "declarationMap": true,
    "stripInternal": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@ifcopenshell/wasm": ["../ifcopenshell-wasm/index.d.ts"],
      "@ifcopenshell/wasm/api": ["../ifcopenshell-wasm/api.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  // Transpiled from ifcopenshell.util and ifcopenshell.api; built by tsconfig.python.json.
  "exclude": ["src/util", "src/api", "src/helpers/placement.ts", "src/helpers/shape.ts", "src/helpers/wall_regeneration.ts", "src/helpers/window.ts", "src/helpers/door.ts", "src/helpers/object_placement.ts", "src/helpers/geolocation.ts", "src/helpers/shape_builder_methods.ts", "src/helpers/dimension.ts", "src/helpers/railing.ts", "src/helpers/alignment.ts", "src/helpers/representation.ts", "src/helpers/structural.ts", "src/helpers/walls.ts", "src/helpers/clipping.ts", "src/helpers/data.ts", "src/helpers/lark.ts"]
}
